{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "twilight-haze-abc1",
  "main": "./worker.js",
  "compatibility_date": "2026-09-20",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
